---
import { stations } from '../content/site';
const minor = Array.from({ length: 41 }, (_, i) => i * 2.5);
---

<aside class="gauge" aria-hidden="true" data-gauge>
  <span class="gauge__zone chart-label" data-gauge-zone>Sunlight zone</span>
  <div class="gauge__track">
    {minor.map((at) => <span class="gauge__minor" style={`--at:${at}%`} />)}
    {stations.map((s) => <span class="gauge__major" data-gauge-station={s.id} style="--at:0%" />)}
    <span class="gauge__marker" data-gauge-marker>
      <span class="gauge__readout mono unit" data-gauge-depth>0 m</span>
    </span>
  </div>
  <span class="gauge__pressure mono unit" data-gauge-pressure>1 atm</span>
</aside>

<style>
  .gauge {
    position: fixed;
    right: 30px;
    top: 50%;
    z-index: 40;
    height: min(58vh, 540px);
    transform: translateY(-50%);
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1s var(--ease-out);
  }
  .gauge.is-ready {
    opacity: 1;
  }
  @media (min-width: 1340px) {
    .gauge {
      display: flex;
    }
  }
  .gauge__zone {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 0.95rem;
    color: var(--ink-2);
    white-space: nowrap;
    height: 8.5em;
    text-align: left;
  }
  .gauge__track {
    position: relative;
    flex: 1;
    width: 1px;
    background: linear-gradient(180deg, var(--line-3), var(--line) 50%, var(--line-2));
  }
  .gauge__minor,
  .gauge__major {
    position: absolute;
    top: var(--at);
    right: 0;
    height: 1px;
    background: var(--ink-4);
  }
  .gauge__minor {
    width: 4px;
    opacity: 0.55;
  }
  .gauge__major {
    width: 11px;
    background: var(--ink-3);
    transition:
      background-color 0.6s,
      box-shadow 0.6s;
  }
  .gauge__major.is-passed {
    background: var(--lume);
    box-shadow: 0 0 8px rgba(127, 227, 208, 0.6);
  }
  .gauge__marker {
    position: absolute;
    right: -3px;
    top: 0;
    width: 7px;
    height: 7px;
    margin-top: -3px;
    border-radius: 50%;
    background: var(--lume-bright);
    box-shadow:
      0 0 0 3px rgba(127, 227, 208, 0.16),
      0 0 16px 2px rgba(127, 227, 208, 0.55);
    will-change: transform;
  }
  .gauge__readout {
    position: absolute;
    right: 18px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--lume);
    white-space: nowrap;
    letter-spacing: 0.04em;
  }
  .gauge__pressure {
    color: var(--ink-3);
    white-space: nowrap;
  }
</style>
