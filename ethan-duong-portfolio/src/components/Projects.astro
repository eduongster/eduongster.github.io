---
import SectionHead from './SectionHead.astro';
import AtlasFeature from './AtlasFeature.astro';
import ProjectIndex from './ProjectIndex.astro';
---

<section id="projects" class="section projects" aria-labelledby="projects-title" data-station="projects">
  <div class="container">
    <SectionHead
      id="projects"
      label="Projects"
      title="Selected <em>work</em>"
      intro="Things I built to understand how they work, starting with the one I’m most excited about."
    />
    <AtlasFeature />
    <ProjectIndex />
  </div>
</section>
