---
/** Small, generic line icons. Brand links use text labels instead of logos. */
interface Props {
  name: 'arrow-down' | 'arrow-out' | 'arrow-up' | 'mail' | 'phone' | 'copy' | 'check' | 'doc' | 'close' | 'fish' | 'loop';
  size?: number;
  class?: string;
}
const { name, size = 18, class: cls } = Astro.props;

const paths: Record<Props['name'], string> = {
  'arrow-down': '<path d="M12 4v15.5M5.5 13 12 19.5 18.5 13"/>',
  'arrow-up': '<path d="M12 20V4.5M5.5 11 12 4.5 18.5 11"/>',
  'arrow-out': '<path d="M7 17 17 7M8.5 7H17v8.5"/>',
  mail: '<rect x="3.5" y="5.5" width="17" height="13" rx="2"/><path d="m4.5 7 7.5 6 7.5-6"/>',
  phone:
    '<path d="M6.6 3.8h2.6l1.4 4-2 1.3a11 11 0 0 0 6.3 6.3l1.3-2 4 1.4v2.6a2 2 0 0 1-2.2 2A16.6 16.6 0 0 1 4.6 6a2 2 0 0 1 2-2.2Z"/>',
  copy: '<rect x="8.5" y="8.5" width="11" height="11" rx="2"/><path d="M15.5 8.5V6.5a2 2 0 0 0-2-2h-7a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h2"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  doc: '<path d="M14 3.5H7.5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2V8Z"/><path d="M14 3.5V8h4.5M9 12.5h6M9 16h6"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  loop: '<path d="M4 12a8 8 0 0 1 13.7-5.6L20 8.5M20 4v4.5h-4.5M20 12a8 8 0 0 1-13.7 5.6L4 15.5M4 20v-4.5h4.5"/>',
  fish: '<path d="M21 12c-2.3-3.1-5.4-4.6-8.6-4.6-3 0-5.6 1.4-7.4 3.4L2.5 8.4v7.2L5 13.2c1.8 2 4.4 3.4 7.4 3.4 3.2 0 6.3-1.5 8.6-4.6Z"/><circle cx="16.3" cy="11.2" r=".9" fill="currentColor" stroke="none"/>',
};
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
