---
import Icon from './Icon.astro';
import { person } from '../content/site';
import { withBase } from '../lib/url';

const resume = withBase(person.resumeFile);
// "Computer Science + Data Science @ UC Berkeley": the + and @ get the accent colour.
const roleParts = person.headline.split(/ (\+|@) /);
const rays = [
  { x: 40, w: 6, r: 9, d: -6, o: 0.45 },
  { x: 55, w: 10, r: 14, d: 0, o: 0.85 },
  { x: 64, w: 4, r: 17, d: -4, o: 0.6 },
  { x: 71, w: 13, r: 20, d: -9, o: 1 },
  { x: 82, w: 6, r: 24, d: -2, o: 0.65 },
  { x: 90, w: 9, r: 27, d: -11, o: 0.5 },
];
---

<section id="top" class="hero" aria-labelledby="hero-name" data-station="top" data-feed-zone>
  <div class="hero__sky" aria-hidden="true">
    <div class="hero__moon"></div>
    <div class="hero__rays">
      {rays.map((r) => <i style={`--x:${r.x}%;--w:${r.w}%;--r:${r.r}deg;--d:${r.d}s;--o:${r.o}`} />)}
    </div>
    <div class="hero__surface"></div>
  </div>

  <div class="container hero__inner">
    <div class="hero__copy" data-fish-avoid>
      <h1 id="hero-name" class="hero__name enter" style="--e:0">
        <span>Ethan</span> <span>Duong</span>
      </h1>
      <p class="hero__role enter" style="--e:1">
        {roleParts.map((part, i) => (i % 2 ? <> <span class="hero__join">{part}</span> </> : part))}
      </p>
      <p class="hero__tagline enter" style="--e:2">{person.tagline}</p>
      <div class="hero__actions enter" style="--e:3">
        <a class="btn btn--primary" href="#projects">
          Explore my work <Icon name="arrow-down" class="arrow-down" />
        </a>
        <div class="hero__links">
          <a class="btn" href={person.github} target="_blank" rel="noopener">
            GitHub <Icon name="arrow-out" class="arrow-out" />
          </a>
          <a class="btn" href={person.linkedin} target="_blank" rel="noopener">
            LinkedIn <Icon name="arrow-out" class="arrow-out" />
          </a>
          <a class="btn" href={resume} target="_blank" rel="noopener" data-resume-link>
            Resume <Icon name="doc" />
          </a>
        </div>
      </div>
      <a class="hero__now enter" style="--e:4" href="#atlas">
        <span class="hero__pulse" aria-hidden="true"></span>
        <span class="mono">Now building</span>
        <span class="hero__now-text">Atlas, a voice AI assistant</span>
        <Icon name="arrow-down" size={15} class="arrow-down" />
      </a>
    </div>
  </div>

  <div class="container hero__foot" aria-hidden="true">
    <span class="mono hero__depth"><span class="unit">0 m</span> <span class="hero__dot">·</span> <span class="chart-label">Surface</span></span>
    <span class="mono hero__cue">Scroll to descend <span class="hero__cue-line"></span></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(100svh, 1080px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: calc(var(--nav-h) + 56px);
    padding-bottom: 120px;
    isolation: isolate;
  }

  /* ---------- Moonlit sky seen from below ---------- */
  .hero__sky {
    position: absolute;
    inset: 0 0 -20% 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    transition: opacity 1.2s var(--ease-out);
    -webkit-mask-image: linear-gradient(180deg, #000 55%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 55%, transparent 100%);
  }
  .hero__moon {
    position: absolute;
    width: 120vmax;
    height: 120vmax;
    right: -38vmax;
    top: -86vmax;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgba(200, 232, 246, 0.26),
      rgba(140, 196, 222, 0.1) 38%,
      rgba(90, 150, 185, 0.04) 60%,
      transparent 76%
    );
  }
  .hero__surface {
    position: absolute;
    inset: 0 0 auto 0;
    height: 26vh;
    background: linear-gradient(180deg, rgba(170, 216, 236, 0.09), transparent);
  }
  .hero__rays i {
    position: absolute;
    top: -6%;
    left: var(--x);
    width: var(--w);
    height: 118%;
    transform-origin: 50% 0;
    transform: rotate(var(--r));
    background: linear-gradient(
      90deg,
      transparent,
      rgba(206, 236, 248, 0.075) 30%,
      rgba(206, 236, 248, 0.13) 50%,
      rgba(206, 236, 248, 0.075) 70%,
      transparent
    );
    -webkit-mask-image: linear-gradient(180deg, #000 0%, rgba(0, 0, 0, 0.55) 40%, transparent 82%);
    mask-image: linear-gradient(180deg, #000 0%, rgba(0, 0, 0, 0.55) 40%, transparent 82%);
    opacity: var(--o);
    animation:
      ray-sway 17s var(--ease-swim) var(--d) infinite alternate,
      ray-breathe 9s ease-in-out var(--d) infinite alternate;
    will-change: transform, opacity;
  }
  @keyframes ray-sway {
    from {
      transform: rotate(calc(var(--r) - 2.4deg));
    }
    to {
      transform: rotate(calc(var(--r) + 2deg));
    }
  }
  @keyframes ray-breathe {
    from {
      opacity: calc(var(--o) * 0.55);
    }
    to {
      opacity: var(--o);
    }
  }

  /* ---------- Copy ---------- */
  .hero__inner {
    position: relative;
  }
  .hero__copy {
    max-width: 780px;
  }
  .hero__name {
    font-family: var(--font-display);
    font-size: var(--fs-hero);
    line-height: 0.9;
    letter-spacing: -0.022em;
    margin-left: -0.04em;
    color: var(--ink);
    text-shadow: 0 0 60px rgba(160, 220, 240, 0.12);
  }
  .hero__name span {
    display: inline-block;
  }
  .hero__name span:last-child {
    font-style: italic;
    color: #d9ecf2;
  }
  .hero__role {
    margin-top: clamp(20px, 2.6vw, 30px);
    font-size: clamp(1.15rem, 1rem + 0.7vw, 1.55rem);
    font-weight: 500;
    letter-spacing: -0.005em;
    color: var(--ink);
  }
  .hero__join {
    color: var(--lume);
    font-weight: 400;
    padding-inline: 0.08em;
  }
  .hero__tagline {
    margin-top: 14px;
    max-width: 44ch;
    font-size: clamp(1.02rem, 0.95rem + 0.3vw, 1.2rem);
    line-height: 1.6;
    color: var(--ink-2);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: clamp(28px, 3.4vw, 40px);
  }
  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .hero__now {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: clamp(34px, 4.6vw, 56px);
    padding: 8px 0;
    color: var(--ink-2);
    font-size: 0.95rem;
    transition: color 0.3s;
  }
  .hero__now .mono {
    color: var(--lume);
  }
  .hero__now:hover {
    color: var(--ink);
  }
  .hero__now:hover :global(.arrow-down) {
    transform: translateY(2px);
  }
  .hero__now :global(.arrow-down) {
    transition: transform 0.4s var(--ease-out);
  }
  .hero__pulse {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--lume-bright);
    box-shadow: 0 0 10px 1px rgba(127, 227, 208, 0.7);
  }
  .hero__pulse::after {
    content: '';
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    border: 1px solid var(--lume);
    opacity: 0;
    animation: sonar 2.8s var(--ease-out) infinite;
  }
  @keyframes sonar {
    0% {
      transform: scale(0.4);
      opacity: 0.8;
    }
    100% {
      transform: scale(2.2);
      opacity: 0;
    }
  }

  /* ---------- Foot ---------- */
  .hero__foot {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--ink-3);
    margin-inline: auto;
  }
  .hero__depth .chart-label {
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.95rem;
    color: var(--ink-2);
  }
  .hero__dot {
    color: var(--ink-4);
  }
  .hero__cue {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .hero__cue-line {
    position: relative;
    width: 1px;
    height: 36px;
    overflow: hidden;
    background: var(--line-2);
  }
  .hero__cue-line::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 12px;
    background: var(--lume);
    animation: cue 2.4s var(--ease-in-out) infinite;
  }
  @keyframes cue {
    from {
      transform: translateY(-14px);
    }
    to {
      transform: translateY(38px);
    }
  }

  /* ---------- Entrance: the page comes into focus ---------- */
  .js .enter {
    animation: focus-in 1.5s var(--ease-out) both;
    animation-delay: calc(120ms + var(--e) * 110ms);
  }
  @keyframes focus-in {
    from {
      opacity: 0.12;
      filter: blur(12px);
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: none;
    }
  }

  @media (max-width: 900px) {
    .hero {
      min-height: auto;
      padding-top: calc(var(--nav-h) + clamp(72px, 12vw, 132px));
      padding-bottom: clamp(112px, 16vw, 160px);
    }
    .hero__name {
      font-size: clamp(4.4rem, 22vw, 10rem);
      line-height: 0.86;
    }
    .hero__name span {
      display: block;
    }
  }
  @media (max-width: 720px) {
    .hero__actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero__actions > .btn--primary {
      width: 100%;
    }
    .hero__links {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }
    .hero__links .btn {
      padding: 0 10px;
      font-size: 0.92rem;
    }
    .hero__foot .hero__cue {
      display: none;
    }
    .hero__moon {
      right: -70vmax;
      top: -90vmax;
    }
  }
  @media (max-width: 380px) {
    .hero__links {
      grid-template-columns: 1fr 1fr;
    }
    .hero__links .btn:last-child {
      grid-column: span 2;
    }
  }
</style>
